{
  "name": "sandboxos",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "SandboxOS \u2014 an MCP-native OS: slug Gateway \u2192 Cell \u2192 MCP Kernel \u2192 Command Central",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "sbx": "packages/sbx-cli/src/sbx.js",
    "tide": "packages/tide/src/cli.js"
  },
  "scripts": {
    "start": "node apps/gateway/src/index.js",
    "dev": "node --watch apps/gateway/src/index.js",
    "test": "node --test --no-warnings",
    "test:better-sqlite3": "SANDBOXOS_DB_DRIVER=better-sqlite3 node --test --no-warnings",
    "tunnel": "echo 'Expose the spine publicly:' && echo '  cloudflared tunnel --url http://localhost:'${SANDBOXOS_PORT:-3939}"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.0.0"
  },
  "exports": {
    ".": "./packages/sdk/src/index.js",
    "./sdk": "./packages/sdk/src/index.js",
    "./sdk/client": "./packages/sdk/src/client.js"
  }
}
